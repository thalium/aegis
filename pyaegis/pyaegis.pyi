# pyaegis.pyi
from __future__ import annotations
from typing import Callable, Literal, Optional, Sequence, Union

# module-level constants
CONTINUE_MSG: int
EXIT_MSG: int
INIT_MSG: int
READ_MSG: int
WRITE_MSG: int

class PyFlagState:
    """
    Represents the CPU flags register state (e.g., EFLAGS/RFLAGS).
    """

    def __init__(self, value: int) -> None: ...
    def __str__(self) -> str: ...
    def compare(self, other: PyFlagState) -> str:
        """
        Compare this flag state with another and return a human-readable diff.
        """
        ...

    @property
    def value(self) -> int: ...

class PyCpuState:
    """
    Represents the full CPU state, including GPRs, segment registers, MMX registers, RIP, and flags.
    """

    def __init__(self) -> None: ...
    def __str__(self) -> str: ...
    def diff(self, other: PyCpuState) -> PyCpuState:
        """
        Compute a diff between this CPU state and another by xoring each register.
        """
        ...
    # MMX registers
    @property
    def mm0(self) -> int: ...
    @mm0.setter
    def mm0(self, v: int) -> None: ...
    @property
    def mm1(self) -> int: ...
    @mm1.setter
    def mm1(self, v: int) -> None: ...
    @property
    def mm2(self) -> int: ...
    @mm2.setter
    def mm2(self, v: int) -> None: ...
    @property
    def mm3(self) -> int: ...
    @mm3.setter
    def mm3(self, v: int) -> None: ...
    @property
    def mm4(self) -> int: ...
