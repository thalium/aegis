class PyNamedTestCase:
    """
    A test case with a unique ID, name, CPU state, and instruction bytes.
    """

    def __init__(
        self, id: int, name: str, state: PyCpuState, insn: Sequence[int]
    ) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def test_case(self) -> PyTestCase: ...

class PyTestCase:
    """
    Low-level representation of a single test case with ID, CPU state, and instruction bytes.
    """

    def __init__(self, id: int, state: PyCpuState, insn: Sequence[int]) -> None: ...
    @property
    def id(self) -> int: ...
    @property
    def state(self) -> PyCpuState: ...
    @property
    def insn(
        self,
    ) -> tuple[
        int, int, int, int, int, int, int, int, int, int, int, int, int, int, int
    ]: ...
    @property
    def size(self) -> int: ...

class PyTest:
    """
    Represents a test run, including the instruction, start and end CPU states.
    """

    def __init__(
        self,
        id: int,
        name: str,
        start_state: PyCpuState,
        end_state: PyCpuState,
        insn: Sequence[int],
    ) -> None: ...
    @property
    def id(self) -> int: ...
    @property
    def name(self) -> str: ...
    @property
    def start_state(self) -> PyCpuState: ...
    @property
    def end_state(self) -> PyCpuState: ...
    @property
    def insn(self) -> list[int]: ...

class PyAegis:
    """
    Main interface to run Aegis tests.

    Args:
        serial_sock: Path to the serial socket used for server communication.
        shared_mem: Path to shared memory (ivshmem) used for client-server communication.
        read: Callback that processes a PyTest result.
        write: Callback that generates a new PyNamedTestCase or "random_8086" mode.
    """

    def __init__(
        self,
        serial_sock: str,
        shared_mem: str,
        read: Callable[[PyTest], None],
        write: Union[
            Callable[[int], Optional[PyNamedTestCase]], Literal["random_8086"]
        ],
    ) -> None: ...
    def run(self) -> None:
        """
        Start the client loop, sending tests to the server and receiving results.
        """
        ...
