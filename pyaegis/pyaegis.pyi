    def mm4(self, v: int) -> None: ...
    @property
    def mm5(self) -> int: ...
    @mm5.setter
    def mm5(self, v: int) -> None: ...
    @property
    def mm6(self) -> int: ...
    @mm6.setter
    def mm6(self, v: int) -> None: ...
    @property
    def mm7(self) -> int: ...
    @mm7.setter
    def mm7(self, v: int) -> None: ...

    # GPRs
    @property
    def rax(self) -> int: ...
    @rax.setter
    def rax(self, v: int) -> None: ...
    @property
    def rbx(self) -> int: ...
    @rbx.setter
    def rbx(self, v: int) -> None: ...
    @property
    def rcx(self) -> int: ...
    @rcx.setter
    def rcx(self, v: int) -> None: ...
    @property
    def rdx(self) -> int: ...
