    def rsi(self, v: int) -> None: ...
    @property
    def rdi(self) -> int: ...
    @rdi.setter
    def rdi(self, v: int) -> None: ...
    @property
    def rbp(self) -> int: ...
    @rbp.setter
    def rbp(self, v: int) -> None: ...
    @property
    def rsp(self) -> int: ...
    @rsp.setter
    def rsp(self, v: int) -> None: ...
    @property
    def r8(self) -> int: ...
    @r8.setter
    def r8(self, v: int) -> None: ...
    @property
    def r9(self) -> int: ...
    @r9.setter
    def r9(self, v: int) -> None: ...
    @property
    def r10(self) -> int: ...
    @r10.setter
    def r10(self, v: int) -> None: ...
    @property
    def r11(self) -> int: ...
    @r11.setter
    def r11(self, v: int) -> None: ...
    @property
    def r12(self) -> int: ...
    @r12.setter
    def r12(self, v: int) -> None: ...
    @property
    def r13(self) -> int: ...
    @r13.setter
    def r13(self, v: int) -> None: ...
    @property
    def r14(self) -> int: ...
